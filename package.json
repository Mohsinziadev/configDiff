{
  "name": "configdiff-js",
  "version": "0.1.0",
  "description": "Structural configuration comparison with risk-aware findings, policy enforcement, and built-in secret redaction. Works offline.",
  "keywords": [
    "config",
    "diff",
    "env",
    "dotenv",
    "yaml",
    "toml",
    "json",
    "lint",
    "ci",
    "policy",
    "secrets",
    "redaction"
  ],
  "license": "MIT",
  "author": "Mohsin Zia <mohsinziadev@gmail.com>",
  "homepage": "https://www.m2toolkit.com/npm-packages/configdiff-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohsinziadev/configdiff.git"
  },
  "bugs": {
    "url": "https://github.com/Mohsinziadev/configdiff/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "configdiff": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepublishOnly": "npm run build && npm test",
    "docs:rules": "npm run build && node scripts/gen-rules-doc.mjs",
    "build:site": "node scripts/build-site.mjs",
    "typecheck:site": "tsc -p demo/tsconfig.json"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "deep-diff": "^1.0.2",
    "eslint": "^9.0.0",
    "marked": "^18.1.2",
    "microdiff": "^1.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
